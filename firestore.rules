rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function isApprovedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // El propio admin puede editar sus datos de contacto (nombre, WhatsApp), pero
      // nunca su campo `enabled` — así nadie puede auto-otorgarse permisos de admin.
      // Crear o eliminar una cuenta de admin sigue reservado al Admin SDK del servidor.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.enabled == resource.data.enabled;
      allow create, delete: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.enabled == false;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.enabled == resource.data.enabled);
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if isAdmin() || isApprovedUser();
      allow write: if isAdmin();
    }

    match /orders/{id} {
      // El precio y la configuración se congelan en el servidor (Admin SDK, ruta
      // /api/orders/create) para que nadie pueda alterarlos desde el cliente.
      allow create: if false;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /contacts/{id} {
      allow read, write: if isAdmin();
    }

    match /analytics/{id} {
      allow read: if isAdmin();
      // Analytics is written exclusively by /api/analytics with Firebase Admin
      // credentials. Blocking direct client writes prevents forged metrics.
      allow write: if false;
    }

    match /settings/{id} {
      // Público de lectura porque cualquier visitante del sitio (sin sesión)
      // necesita saber si la protección de imágenes está activa.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /optionGroups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productOptions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
